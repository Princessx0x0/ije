# Copy to agent/.env for local development. Nothing here is a secret.
# Gemini runs on Vertex AI through Application Default Credentials
# (`gcloud auth application-default login`). There are no API keys (ADR 002).
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=ije-travel-511008
GOOGLE_CLOUD_LOCATION=us-central1

# Set only on Agent Runtime (scripts/deploy-agent.sh); switches to managed sessions.
# AGENT_ENGINE_ID=
# AGENT_ENGINE_LOCATION=us-central1
