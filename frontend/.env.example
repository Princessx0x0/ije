# Copy to .env.local for local development. Nothing in this file is a secret.
# There are no API keys: the agent uses Vertex AI through Application Default
# Credentials (ADR 002), and CopilotKit Intelligence is not used (ADR 004).

# Agent Runtime passthrough base, ending in /api. Leave unset locally to use
# the agent on http://localhost:8000. On Cloud Run set it to:
# https://us-central1-aiplatform.googleapis.com/reasoningEngines/v1/projects/788712976210/locations/us-central1/reasoningEngines/2768957581710852096/api
# AGENT_RUNTIME_URL=

# Firebase web config (Project settings > Your apps > Web app). These identify
# the project; Firestore security rules are what protect the data.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ije-travel-511008.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ije-travel-511008
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=788712976210
NEXT_PUBLIC_FIREBASE_APP_ID=
